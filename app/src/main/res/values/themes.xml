<resources>
    <style name="Theme.MedRemind" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Official Android 12+ splash screen so there is no white/black flash. -->
    <style name="Theme.MedRemind.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4E75F4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MedRemind</item>
    </style>
</resources>
